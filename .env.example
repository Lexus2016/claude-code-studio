# Port (default 3000)
PORT=3000

# Session encryption secret (auto-generated on first run if empty)
SESSION_SECRET=

# Trust reverse proxy headers (true if behind nginx/caddy)
TRUST_PROXY=false

# Working directory for Claude Code
WORKDIR=./workspace

# Max parallel Claude Code processes for Kanban tasks (default 5)
MAX_TASK_WORKERS=5

# ── Run limits: how long a Claude run may take ──────────────────
# Read once at startup — restart the server after changing any of these.

# INACTIVITY watchdog, not a total runtime limit (default 600000 = 10 min).
# The timer resets on every chunk of output, so it only fires after complete
# silence — which does happen during a long Bash call, an MCP call, or a
# Task-tool subagent, since none of those stream output while they run.
# For "let it run for up to an hour of silence": 3600000
# Shipped here as 30 min — an override of the 10-min code default, not the default.
CLAUDE_IDLE_TIMEOUT_MS=1800000

# Legacy alias for CLAUDE_IDLE_TIMEOUT_MS, kept for compatibility.
# CLAUDE_TIMEOUT_MS=1800000

# Absolute wall-clock ceiling for one Claude run (default 0 = disabled).
# Unlike the idle watchdog this kills a run that IS producing output.
# Use it only as a backstop, e.g. 3600000 for a hard 1-hour cap.
# CLAUDE_HARD_CAP_MS=0

# How long a running task survives after the browser tab detaches
# (default 1800000 = 30 min). Reattaching cancels it. 0 = never abort,
# so a task keeps running to the end even with no browser connected.
# TASK_DISCONNECT_TIMEOUT_MS=1800000

# Ceiling on turns per sub-agent in multi-agent mode (default 200, matching the
# UI's "Turns" field). A sub-agent that exhausts its turns auto-continues up to
# 3 times, so worst case per agent is 4x this number. Lower it to cap spend.
# MULTI_AGENT_MAX_TURNS_CAP=200

# ── LLM Proxy / Gateway (optional) ──────────────────────────────
# Route Claude CLI requests through a proxy like LiteLLM, Bifrost, or OpenRouter.
# Leave empty to use Anthropic directly (Max subscription / ANTHROPIC_API_KEY).
#
# ANTHROPIC_BASE_URL=http://localhost:4000
# ANTHROPIC_AUTH_TOKEN=your-proxy-master-key
#
# Strip experimental beta headers that break non-Anthropic backends (Bedrock, Vertex):
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
