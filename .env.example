# Port (default 3000)
PORT=3000

# Bind address (default 127.0.0.1 — localhost only).
# This UI runs `claude --dangerously-skip-permissions` with Bash rooted at $HOME,
# so anyone who reaches the port is one password away from a shell on this machine.
# Set 0.0.0.0 to reach it from your phone or another machine on the LAN — and
# expect the console to warn you about it on every start. Docker sets this itself.
# HOST=0.0.0.0

# Session encryption secret (auto-generated on first run if empty)
SESSION_SECRET=

# Trust reverse proxy headers (true if behind nginx/caddy)
TRUST_PROXY=false

# Extra origins allowed to POST and to open a WebSocket, comma-separated.
# The server compares Origin against Host, so a normal reverse proxy needs
# nothing here. Set it only when the proxy rewrites Host and the two no longer
# match (e.g. Host: 127.0.0.1:3000 behind https://studio.example.com).
# CCS_ALLOWED_ORIGINS=https://studio.example.com

# Working directory for Claude Code
WORKDIR=./workspace

# Max parallel Claude Code processes for Kanban tasks (default 5)
MAX_TASK_WORKERS=5

# ── Run limits: how long a Claude run may take ──────────────────
# Read once at startup — restart the server after changing any of these.

# INACTIVITY watchdog, not a total runtime limit (default 600000 = 10 min).
# The timer resets on every chunk of output, so it only fires after complete
# silence — which does happen during a long Bash call, an MCP call, or a
# Task-tool subagent, since none of those stream output while they run.
# For "let it run for up to an hour of silence": 3600000
# Shipped here as 30 min — an override of the 10-min code default, not the default.
CLAUDE_IDLE_TIMEOUT_MS=1800000

# Legacy alias for CLAUDE_IDLE_TIMEOUT_MS, kept for compatibility.
# CLAUDE_TIMEOUT_MS=1800000

# Absolute wall-clock ceiling for one Claude run (default 0 = disabled).
# Unlike the idle watchdog this kills a run that IS producing output.
# Use it only as a backstop, e.g. 3600000 for a hard 1-hour cap.
# CLAUDE_HARD_CAP_MS=0

# How long a running task survives after the browser tab detaches
# (default 1800000 = 30 min). Reattaching cancels it. 0 = never abort,
# so a task keeps running to the end even with no browser connected.
# TASK_DISCONNECT_TIMEOUT_MS=1800000

# Ceiling on turns per sub-agent in multi-agent mode (default 200, matching the
# UI's "Turns" field). A sub-agent that exhausts its turns auto-continues up to
# 3 times, so worst case per agent is 4x this number. Lower it to cap spend.
# MULTI_AGENT_MAX_TURNS_CAP=200

# ── LLM Proxy / Gateway (optional) ──────────────────────────────
# Route Claude CLI requests through a proxy like LiteLLM, Bifrost, or OpenRouter.
# Leave empty to use Anthropic directly (Max subscription / ANTHROPIC_API_KEY).
#
# ANTHROPIC_BASE_URL=http://localhost:4000
# ANTHROPIC_AUTH_TOKEN=your-proxy-master-key
#
# Strip experimental beta headers that break non-Anthropic backends (Bedrock, Vertex):
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# ── Database maintenance ────────────────────────────────────────
# Sessions older than this are DELETED at startup and every
# CLEANUP_INTERVAL_HOURS afterwards; their messages are archived first.
# This is data loss on a timer — raise it (or set a very large value)
# if you keep long-lived chats around.
# SESSION_TTL_DAYS=30
# CLEANUP_INTERVAL_HOURS=24

# ── Logging ─────────────────────────────────────────────────────
# error | warn | info | debug (default info).
# NODE_ENV=production switches the output to newline-delimited JSON.
# LOG_LEVEL=info

# ── Anthropic credentials (optional) ────────────────────────────
# Only needed for the "API" engine when you are not signed in through the
# claude CLI. The Subscription engine (Claude Max) does not use this.
# ANTHROPIC_API_KEY=

# ── Docker build ────────────────────────────────────────────────
# Registry mirror prefix used by docker-compose for the base image
# (e.g. MIRROR=dockerhub.example.com → dockerhub.example.com/node:20-bookworm).
# MIRROR=

# ── Subscription engine (tmux) ──────────────────────────────────
# How long a turn may sit on a blocking interactive prompt (permission
# question, plan approval, AskUserQuestion) before the watchdog is allowed
# to call it done (default 300000 = 5 min). The prompt is answered from the
# browser through the engine pane; this is only the budget for waiting.
# CLAUDE_PROMPT_GRACE_MS=300000

# How long to wait for the interactive CLI to print its first prompt after
# spawn (default 90000 = 90 s). Raise it on a slow machine or a cold MCP set.
# CLAUDE_STARTUP_PROMPT_WAIT_MS=90000

# ── SSH remote hosts ────────────────────────────────────────────
# Host-key policy for outgoing SSH. Default is trust-on-first-use: the first
# fingerprint seen is pinned in data/ssh-known-hosts.json and a later change
# is refused. Set `accept-any` to skip verification entirely — that removes
# the protection against a man-in-the-middle and is only sane on a LAN you own.
# CCS_SSH_HOST_KEY_POLICY=tofu

# Ceilings on a single remote command run over SSH.
# CCS_REMOTE_EXEC_TIMEOUT_MS=30000
# CCS_REMOTE_EXEC_MAX_BYTES=67108864

# Extra shell run on the remote host before `claude`, after the version-manager
# PATH setup and after the cd into the project, so it can override either.
# The built-in setup already covers mise, asdf, nvm, pyenv, rbenv, nodenv, fnm,
# volta, bun, cargo and sdkman; this is the escape hatch for anything else — a
# login shell is not an interactive one, so ~/.bashrc never runs for us.
# CCS_REMOTE_INIT=source /opt/toolchain/env.sh

# Ceilings on importing CLI sessions from a remote host: per transcript,
# and for the whole import (defaults 32 MB / 128 MB).
# CCS_REMOTE_IMPORT_MAX_BYTES=33554432
# CCS_REMOTE_IMPORT_MAX_TOTAL=134217728

# ── Paths and process ───────────────────────────────────────────
# Where data/, config.json, .env and skills/ live. Defaults to the directory
# server.js sits in; the npx/global launcher sets it to your cwd so a global
# install keeps its state next to you instead of inside node_modules.
# APP_DIR=

# Node binary used when the server spawns its own helpers (MCP servers,
# task workers). Set it if `node` on PATH is not the one you want.
# CCS_NODE_CMD=node

# Where config.json and .env themselves live. Only needed when the app directory
# is not writable across restarts — Docker sets both to the data volume, because
# /app is an image layer and every setting written through the config UI would
# otherwise vanish on the next `docker compose up`.
# CCS_CONFIG_PATH=/app/data/config.json
# CCS_ENV_PATH=/app/data/.env

# How long an uploaded interrupt attachment stays on disk before it is swept
# (default 1800000 = 30 min).
# CCS_INTERRUPT_FILE_TTL_MS=1800000
